rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() { return signedIn() && request.auth.token.admin == true; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }

    match /public/main {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /admin/main {
      allow read, write: if isAdmin();
    }

    match /plans/{planId} {
      allow read: if resource.data.active == true || isAdmin();
      allow write: if isAdmin();
    }

    match /subscriptions/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow write: if false;
    }

    match /payments/{paymentId} {
      allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow write: if false;
    }

    match /manualPaymentSettings/main {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /paymentSettings/main {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    match /vipGames/{gameId} {
      allow read, write: if isAdmin();
    }

    match /activationCodes/{codeId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow write: if isOwner(uid) || isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
